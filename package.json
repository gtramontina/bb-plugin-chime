  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "bb plugin build",
    "generate:sounds": "node scripts/generate-sounds.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
