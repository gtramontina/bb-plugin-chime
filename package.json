  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.6",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "bb-app": "0.38.0",
    "better-sqlite3": "12.11.1",
    "cron-parser": "5.10.0",
    "hono": "4.13.2",
    "jsdom": "26.1.0",
